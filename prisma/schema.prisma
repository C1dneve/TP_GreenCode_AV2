generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum PapelUsuario {
  ADMINISTRADOR
  OPERADOR_CADASTRO
  GESTOR_ALMOXARIFADO
  AUDITOR
}

enum TipoEquipamento {
  COMPUTADOR_MESA
  NOTEBOOK
  MONITOR
  IMPRESSORA
  SERVIDOR
  ROTEADOR
  CABO_ESTRUTURADO
  FONTE_ALIMENTACAO
}

enum EstadoFisico {
  NOVO
  BOM_ESTADO
  USADO_LEVE
  USADO_MODERADO
  DANIFICADO_LEVE
  DANIFICADO_GRAVE
  INSERVIVEL
}

enum StatusRastreamento {
  AGUARDANDO_TRIAGEM
  EM_TRIAGEM
  AGUARDANDO_DESMONTE
  EM_DESMONTE
  PECAS_REAPROVEITADAS
  MATERIAL_RECICLAVEL
  DESCARTE_SEGURO
  BAIXA_DEFINITIVA
}

enum StatusProcessamentoLote {
  RECEBIDO
  EM_TRIAGEM
  TRIAGEM_CONCLUIDA
  ENCAMINHADO
  FINALIZADO
}

model Usuario {
  id                    String             @id @default(uuid()) @db.Uuid
  usuario               String             @unique @db.VarChar(80)
  nome                  String             @db.VarChar(120)
  senhaHash             String             @db.VarChar(255)
  papel                 PapelUsuario
  ativo                 Boolean            @default(true)
  ultimoAcesso          DateTime?          @db.Timestamptz(3)
  createdAt             DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @db.Timestamptz(3)
  versao                Int                @default(1)
  tokensRevogados       TokenRevogado[]
  movimentacoes         Movimentacao[]
  auditorias            EventoAuditoria[]   @relation("AuditoriaAtor")
  parametrosAtualizados ParametroGlobal[]   @relation("ParametroAtualizadoPor")

  @@index([ativo, papel])
  @@map("usuarios")
}

model TokenRevogado {
  jti       String   @id @db.VarChar(100)
  usuarioId String   @db.Uuid
  expiraEm  DateTime @db.Timestamptz(3)
  revogadoEm DateTime @default(now()) @db.Timestamptz(3)
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([usuarioId, expiraEm])
  @@index([expiraEm])
  @@map("tokens_revogados")
}

model Organizacao {
  id                 String     @id @default(uuid()) @db.Uuid
  razaoSocial        String     @db.VarChar(180)
  cnpj               String     @unique @db.VarChar(14)
  inscricaoEstadual  String?    @db.VarChar(30)
  enderecoCompleto   String?    @db.VarChar(300)
  telefone           String?    @db.VarChar(30)
  email              String?    @db.VarChar(254)
  dataCadastro       DateTime   @default(now()) @db.Timestamptz(3)
  ativo              Boolean    @default(true)
  createdAt          DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @db.Timestamptz(3)
  versao             Int        @default(1)
  contratos          Contrato[]
  lotes              Lote[]

  @@index([razaoSocial])
  @@index([ativo])
  @@map("organizacoes")
}

model Contrato {
  id                  String       @id @default(uuid()) @db.Uuid
  organizacaoId       String       @db.Uuid
  dataAssinatura      DateTime     @default(now()) @db.Timestamptz(3)
  dataVencimento      DateTime     @db.Timestamptz(3)
  clausulas           String[]     @default([])
  valorMensal         Decimal      @db.Decimal(12, 2)
  renovacaoAutomatica Boolean      @default(false)
  ativo               Boolean      @default(true)
  dataCancelamento    DateTime?    @db.Timestamptz(3)
  createdAt           DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime     @updatedAt @db.Timestamptz(3)
  versao              Int          @default(1)
  organizacao         Organizacao  @relation(fields: [organizacaoId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([organizacaoId, dataVencimento])
  @@index([ativo, dataVencimento])
  @@map("contratos")
}

model Lote {
  id                 String                 @id @default(uuid()) @db.Uuid
  organizacaoId      String                 @db.Uuid
  dataEntrada        DateTime               @default(now()) @db.Timestamptz(3)
  notaFiscal         String                 @db.VarChar(100)
  transportadora     String                 @db.VarChar(120)
  statusProcessamento StatusProcessamentoLote @default(RECEBIDO)
  observacoes        String                 @default("") @db.VarChar(2000)
  ativo              Boolean                @default(true)
  createdAt          DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime               @updatedAt @db.Timestamptz(3)
  versao             Int                    @default(1)
  organizacao        Organizacao            @relation(fields: [organizacaoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  equipamentos       Equipamento[]

  @@index([organizacaoId, statusProcessamento])
  @@index([dataEntrada])
  @@index([ativo])
  @@map("lotes")
}

model Equipamento {
  id                 String             @id @default(uuid()) @db.Uuid
  codigoBarrasInterno String             @unique @db.VarChar(64)
  tipo               TipoEquipamento
  marca              String             @db.VarChar(100)
  modelo             String             @db.VarChar(120)
  anoFabricacao      Int
  estadoFisico       EstadoFisico
  pesoQuilogramas    Decimal            @db.Decimal(10, 3)
  loteId             String?            @db.Uuid
  posicaoNoLote       Int?
  statusRastreamento StatusRastreamento  @default(AGUARDANDO_TRIAGEM)
  ativo              Boolean            @default(true)
  valorAquisicao     Decimal            @default(0) @db.Decimal(12, 2)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)
  versao             Int                @default(1)
  lote               Lote?              @relation(fields: [loteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  movimentacoes      Movimentacao[]

  // SQL migration owns the partial unique index: Prisma @@unique requires all
  // compound fields to be mandatory, but this approved relationship is optional.
  @@index([loteId, statusRastreamento])
  @@index([tipo, estadoFisico])
  @@index([ativo])
  @@map("equipamentos")
}

model Movimentacao {
  id                       String      @id @default(uuid()) @db.Uuid
  equipamentoId            String      @db.Uuid
  dataHora                 DateTime    @default(now()) @db.Timestamptz(3)
  origem                   String      @db.VarChar(180)
  destino                  String      @db.VarChar(180)
  responsavelId            String      @db.Uuid
  responsavelNomeSnapshot  String      @db.VarChar(120)
  observacao               String      @default("") @db.VarChar(2000)
  equipamento              Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  responsavel              Usuario     @relation(fields: [responsavelId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([equipamentoId, dataHora])
  @@index([responsavelId, dataHora])
  @@map("movimentacoes")
}

model EventoAuditoria {
  id                 String    @id @default(uuid()) @db.Uuid
  atorUsuarioId      String?   @db.Uuid
  atorNomeSnapshot   String?   @db.VarChar(120)
  acao               String    @db.VarChar(80)
  entidade           String    @db.VarChar(80)
  entidadeId         String    @db.VarChar(100)
  instante           DateTime  @default(now()) @db.Timestamptz(3)
  resultado          String    @db.VarChar(30)
  requestId          String?   @db.VarChar(100)
  detalhes            Json?
  ator               Usuario?  @relation("AuditoriaAtor", fields: [atorUsuarioId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([instante])
  @@index([entidade, entidadeId, instante])
  @@index([atorUsuarioId, instante])
  @@map("eventos_auditoria")
}

model ParametroGlobal {
  id                           String    @id @default("global") @db.VarChar(20)
  aliquotaImpostoPercentual    Decimal   @default(0) @db.Decimal(5, 2)
  taxaDepreciacaoAnualPercentual Decimal  @default(15) @db.Decimal(5, 2)
  atualizadoPorId              String?   @db.Uuid
  createdAt                    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt                    DateTime  @updatedAt @db.Timestamptz(3)
  versao                       Int       @default(1)
  atualizadoPor                Usuario?  @relation("ParametroAtualizadoPor", fields: [atualizadoPorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("parametros_globais")
}
